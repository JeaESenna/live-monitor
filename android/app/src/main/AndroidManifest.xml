<?xml version="1.0" encoding="utf-8"?>
<!--
  LiveMonitor Android

  Hardening /最小权限说明（同样适用于安全评审）:
  - 只有主营 Activity 导出；Service 一律 exported=false，不接受外部调用。
  - allowBackup=false：直播列表/设置仅保存在本机，不进入云备份、不 via adb backup 导出。
  - usesCleartextTraffic=false + networkSecurityConfig：禁止明文 HTTP，仅信任系统 CA。
  - 无 WebView、无 JS 桥、无动态加载、无悬浮窗/无障碍/定位/通讯录等敏感权限。
  - 不使用 RECEIVE_BOOT_COMPLETED：不做开机自启，减少后台启动面与耗电。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 仅访问用户主动添加的直播平台公开页面；无定位、通讯录、短信、存储权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 本地开播提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务：持续监测并显示常驻通知（Android 14+ 的 specialUse 类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 仅在每轮检测期间短暂持锁，屏幕熄灭时也能完成一次紧凑的网络轮询 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Android 11+ 包可见性：为了“优先打开平台 App”的功能，只声明这 5 个平台包，
      不申请 QUERY_ALL_PACKAGES（避免暴露本机全部已安装应用）。
    -->
    <queries>
        <package android:name="air.tv.douyu.android" />
        <package android:name="com.duowan.kiwi" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.smile.gifmaker" />

        <!-- 仅用于“浏览器打开网页版”时解析系统默认浏览器并显式启动，不枚举其他应用能力 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiveMonitor"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LiveMonitor"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          “进入直播间”的跳转/选择弹窗（App 内直播间 / 浏览器网页版 / 下载 App）。
          不导出：只能由本 App 的界面或通知 PendingIntent 启动；
          不接收外部传入 URL，只接收本机已保存的房间 key。
        -->
        <activity
            android:name=".ui.RoomJumpActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.LiveMonitor.Dialog"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".core.monitor.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous polling of user-configured public live-streamer status pages to deliver local reminder notifications. No remote data is collected. This app is a local reminder tool; the user explicitly adds each room and can stop monitoring at any time." />
        </service>
    </application>

</manifest>
